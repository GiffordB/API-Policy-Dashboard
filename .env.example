# ---- database (Render Postgres: copy the External Database URL) ----
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- source API keys ----
# Federal Register needs no key and works out of the box.
# One key covers Regulations.gov, Congress.gov and GovInfo: https://api.data.gov/signup/
DATA_GOV_API_KEY=""
# https://open.pluralpolicy.com/accounts/profile/   (state bills)
OPENSTATES_API_KEY=""
# https://www.courtlistener.com/profile/apis/       (federal dockets)
COURTLISTENER_TOKEN=""

# ---- pilot access gate ----
# A shared password for the pilot. This is NOT single sign-on and NOT per-person
# security. Replace it with your identity provider before a general rollout.
APP_PASSWORD=""

# ---- collector job ----
# Render cron calls /api/collect with this header. Generate: openssl rand -hex 32
COLLECT_SECRET=""
